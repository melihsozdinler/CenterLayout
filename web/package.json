{
  "name": "prolivis",
  "version": "2.0.0",
  "description": "ProLiVis 2.0 \u2014 Protein-Protein Interaction Literature Visualization System. A zero-install, static web application for BioGRID PPI networks with citation-trust scoring.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/melihsozdinler/CenterLayout"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "figures": "playwright test --config playwright.figures.config.ts figures.spec",
    "screenshots": "playwright test --config playwright.figures.config.ts screenshots",
    "supplement": "playwright test --config playwright.figures.config.ts supplement"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "apache-arrow": "^17.0.0",
    "d3-array": "^3.2.4",
    "d3-chord": "^3.0.1",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-shape": "^3.2.0",
    "fflate": "^0.8.2",
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sigma": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@types/d3-array": "^3.2.1",
    "@types/d3-chord": "^3.0.6",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-scale-chromatic": "^3.0.3",
    "@types/d3-shape": "^3.1.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
